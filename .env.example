# Copy to .env. Every value is optional — with none of them set the app runs in
# demo mode, which is enough to click around but stores nothing.

# --- Database -----------------------------------------------------------
# Any Postgres works. Neon is the easy default: it has a free tier and a
# first-party Vercel integration. (Vercel's own Postgres product was retired
# and folded into Neon, so "Vercel Postgres" now means Neon.)
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Sign-in ------------------------------------------------------------
# Needs DATABASE_URL plus at least one provider. Generate the secret with
# `npx auth secret`.
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"   # set to the deployed URL in production

# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# discord.com/developers/applications -> OAuth2
# Redirect URI: http://localhost:3000/api/auth/callback/discord
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# --- Admin --------------------------------------------------------------
# Comma-separated emails allowed to edit categories at /admin.
# ADMIN_EMAILS="you@example.com"

# --- Title data ---------------------------------------------------------
# themoviedb.org/settings/api — free for non-commercial use with attribution.
# Accepts either the v3 API key or the v4 read access token.
# Without it, search falls back to titles already in your database.
# TMDB_API_KEY=""
