# Copy to .env. Every value is optional — with none of them set the app runs in
# demo mode, which is enough to click around but stores nothing.

# --- Database (Supabase) ------------------------------------------------
# Both URLs come from: Supabase dashboard → Project → Connect.

# Pooled, for the running app. Supavisor transaction mode, port 6543.
# src/db/index.ts detects the pooler hostname and disables prepared statements,
# which transaction mode cannot support.
# DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Direct, for schema changes only (db:push, db:seed, enrich).
# IPv6-only without Supabase's IPv4 add-on — on an IPv4-only network use the
# session pooler (port 5432) here instead.
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres"

# --- Sign-in ------------------------------------------------------------
# Needs DATABASE_URL plus at least one provider. Generate with `npx auth secret`.
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"   # set to the deployed URL in production

# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# discord.com/developers/applications -> OAuth2
# Redirect URI: http://localhost:3000/api/auth/callback/discord
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# --- Admin --------------------------------------------------------------
# Comma-separated emails allowed to edit categories at /admin.
# ADMIN_EMAILS="you@example.com"

# --- Title data ---------------------------------------------------------
# themoviedb.org/settings/api — free for non-commercial use with attribution.
# Accepts either the v3 API key or the v4 read access token.
# Without it, search falls back to titles already in your database.
# TMDB_API_KEY=""
